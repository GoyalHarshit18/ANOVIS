# ==============================================================================
# Anovis / BurnSight-AI Backend Environment Variables
# ==============================================================================

PORT=8000
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# Frontend CORS
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Models
MODEL_DIR=./models

# Supabase PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:your_db_password@db.your_project.supabase.co:5432/postgres

# Supabase Storage (Backend service role ONLY)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=qa-reports

# Google Gemini API (Backend ONLY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
